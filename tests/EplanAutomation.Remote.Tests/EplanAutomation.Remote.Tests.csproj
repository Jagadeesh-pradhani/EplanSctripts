
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>

    <EplanBin>E:\Eplan\Platform\2026.0.3\Bin</EplanBin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net481"
                      Version="1.0.3"
                      PrivateAssets="All" />

    <PackageReference Include="System.Memory"
                      Version="4.5.5" />

    <PackageReference Include="System.Runtime.CompilerServices.Unsafe"
                      Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Eplan.EplApi.RemoteClientu">
      <HintPath>$(EplanBin)\Eplan.EplApi.RemoteClientu.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Eplan.EplApi.Remotingu">
      <HintPath>$(EplanBin)\Eplan.EplApi.Remotingu.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Google.Protobuf">
      <HintPath>$(EplanBin)\Google.Protobuf.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Grpc.Core.Api">
      <HintPath>$(EplanBin)\Grpc.Core.Api.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Grpc.Core">
      <HintPath>$(EplanBin)\Grpc.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="System.Runtime.Remoting" />

  </ItemGroup>

  <ItemGroup>
    <Content Include="$(EplanBin)\Grpc_csharp_ext.x64.dll">
      <Link>Grpc_csharp_ext.x64.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>